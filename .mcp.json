{
  "mcpServers": {
    "chrome-devtools": {
      "command": "cmd",
      "args": [
        "/c", "npx", "-y", "chrome-devtools-mcp@1.10.1",
        "--isolated",
        "--categoryExtensions",
        "--filesystemRoot=.",
        "--executablePath=${CHROME_PATH:-C:/Program Files/BraveSoftware/Brave-Browser/Application/brave.exe}",
        "--usageStatistics=false",
        "--performanceCrux=false",
        "--redactNetworkHeaders",
        "--screenshotMaxWidth=1200",
        "--blockedUrlPattern=*://maybank2u.com.my/*",
        "--blockedUrlPattern=*://*.maybank2u.com.my/*",
        "--blockedUrlPattern=*://cimbclicks.com.my/*",
        "--blockedUrlPattern=*://*.cimbclicks.com.my/*",
        "--blockedUrlPattern=*://budgetbakers.com/*",
        "--blockedUrlPattern=*://*.budgetbakers.com/*"
      ]
    }
  }
}
